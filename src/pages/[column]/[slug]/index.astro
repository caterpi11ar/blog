---
import type { Column } from '@utils/columns'
import type { ColumnPost } from '@utils/postTypes'
import { SITE } from '@config'
import PostDetails from '@layouts/PostDetails.astro'
import Posts from '@layouts/Posts.astro'
import { getColumnPosts, getColumns } from '@utils/columns'
import { getAdjacentPost, getAdjacentPosts } from '@utils/getAdjacentPosts'
import getPageNumbers from '@utils/getPageNumbers'
import slugify from '@utils/slugify'
import { getCollection } from 'astro:content'

export interface Props {
  column: Column
  post?: ColumnPost
  prevPost?: ColumnPost
  nextPost?: ColumnPost
}

export async function getStaticPaths() {
  const allColumnPosts = await getCollection('columns')
  const publishedPosts = allColumnPosts.filter(({ data }) => !data.draft)
  const adjacentPosts = getAdjacentPosts(publishedPosts)
  const columns = getColumns(allColumnPosts)

  const paths: Array<Record<string, unknown>> = []

  columns.forEach((column) => {
    const postsInColumn = getColumnPosts(publishedPosts, column.slug)

    postsInColumn.forEach((post) => {
      const adjacent = getAdjacentPost(post, adjacentPosts)

      paths.push({
        params: { column: column.slug, slug: slugify(post.data) },
        props: {
          column,
          post,
          prevPost: adjacent?.prevPost as ColumnPost | undefined,
          nextPost: adjacent?.nextPost as ColumnPost | undefined,
        },
      })
    })

    getPageNumbers(postsInColumn.length)
      .filter(pageNum => pageNum > 1)
      .forEach((pageNum) => {
        paths.push({
          params: { column: column.slug, slug: String(pageNum) },
          props: { column },
        })
      })
  })

  return paths
}

const { column, post, prevPost, nextPost } = Astro.props
const { slug } = Astro.params

const posts = await getCollection('columns')
const sortedPosts = getColumnPosts(posts, column.slug)
const totalPages = getPageNumbers(sortedPosts.length)
const currentPage
  = slug && !Number.isNaN(Number(slug)) && totalPages.includes(Number(slug))
    ? Number(slug)
    : 0
const lastPost = currentPage * SITE.postPerPage
const startPost = lastPost - SITE.postPerPage
const paginatedPosts = sortedPosts.slice(startPost, lastPost);
---

{
  post ? (
    <PostDetails post={post} prevPost={prevPost} nextPost={nextPost} />
  ) : (
    <Posts
      posts={paginatedPosts}
      pageNum={currentPage}
      totalPages={totalPages.length}
      pageTitle={column.title}
      pageDesc={`${column.title} column articles.`}
      activeNav={column.slug}
      basePath={`/${column.slug}`}
    />
  )
}
